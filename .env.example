# Generate .env using: python scripts/init_env.py
TOKENOS_API_KEY=replace-with-a-random-key-of-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
TOKENOS_BACKEND=postgres
# Local process database address. Compose overrides hostname to db.
TOKENOS_DATABASE_URL=postgresql://tokenos:replace-with-a-random-database-password@localhost:5432/tokenos
TOKENOS_DEMO_ENABLED=true
TOKENOS_SAFETY_TOKENS=32
TOKENOS_PROVIDER_TIMEOUT_SECONDS=30
TOKENOS_MAX_TASK_BUDGET=1000000
TOKENOS_MAX_OUTPUT_TOKENS=2000
TOKENOS_MAX_PROMPT_CHARACTERS=16000
TOKENOS_POOL_MIN=1
TOKENOS_POOL_MAX=10
TOKENOS_LOG_LEVEL=INFO
TOKENOS_OTEL_EXPORT=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://your-collector:4318
TOKENOS_API_PORT=8000
TOKENOS_DB_PORT=5432


# Adaptive runtime (sandbox by default)
TOKENOS_RUNTIME_PROVIDER=sandbox
TOKENOS_POLICY_FILE=config/policy.json
TOKENOS_SANDBOX_FIXTURE=config/sandbox.json
TOKENOS_CONCURRENCY=4
TOKENOS_MCP_SERVERS={}
# TOKENOS_GEMINI_API_KEY=your-key
# TOKENOS_GEMINI_MODEL=your-model-id
